{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "estamp",
  "version": "0.0.1",
  "identifier": "jp.tyaro.estamp",
  "build": {
    "beforeDevCommand": "corepack yarn dev",
    "beforeBuildCommand": "corepack yarn build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null,
      "capabilities": [
        "main-window"
      ]
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "電子印",
        "width": 250,
        "height": 120,
        "maxWidth": 250,
        "maxHeight": 310
      }
    ]
  },
  "bundle": {
    "active": true,
    "publisher": "Banto Works",
    "copyright": "Copyright (c) 2026 Banto Works",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../public/fonts/bizudpgothic/OFL.txt": "licenses/fonts/bizudpgothic/OFL.txt",
      "../public/fonts/shipporiminchob1/OFL.txt": "licenses/fonts/shipporiminchob1/OFL.txt",
      "../licenses/skeleton-LICENSE.txt": "licenses/skeleton-LICENSE.txt"
    },
    "shortDescription": "画像の日付印を作るアプリ",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  }
}
