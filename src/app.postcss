/* Write your global styles here, in PostCSS syntax 
@tailwind base;
@tailwind components;
@tailwind utilities;
*/
html, body { @apply h-full overflow-hidden; }

@font-face {
  font-family: 'BIZ UDPGothic';
  src: url('/fonts/bizudpgothic/BIZUDPGothic-Regular.ttf') format('truetype');
  font-style: normal;
  font-weight: 400;
  font-display: swap;
}
@font-face {
  font-family: 'BIZ UDPGothic';
  src: url('/fonts/bizudpgothic/BIZUDPGothic-Bold.ttf') format('truetype');
  font-style: normal;
  font-weight: 700;
  font-display: swap;
}
@font-face {
  font-family: 'Shippori Mincho B1';
  src: url('/fonts/shipporiminchob1/ShipporiMinchoB1-Regular.ttf') format('truetype');
  font-style: normal;
  font-weight: 400;
  font-display: block;
}
@font-face {
  font-family: 'Shippori Mincho B1';
  src: url('/fonts/shipporiminchob1/ShipporiMinchoB1-Bold.ttf') format('truetype');
  font-style: normal;
  font-weight: 700;
  font-display: block;
}

html, body, button, input, select, textarea {
  font-family: 'BIZ UDPGothic', sans-serif;
  font-size: 14px;
}
th, strong, summary { font-weight: 700; }
