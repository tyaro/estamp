@font-face {
  font-family: 'estamp BIZ UDPGothic';
  src: url('/fonts/bizudpgothic/BIZUDPGothic-Regular.ttf') format('truetype');
  font-style: normal;
  font-weight: 400;
  font-display: swap;
}
@font-face {
  font-family: 'estamp BIZ UDPGothic';
  src: url('/fonts/bizudpgothic/BIZUDPGothic-Bold.ttf') format('truetype');
  font-style: normal;
  font-weight: 700;
  font-display: swap;
}
@font-face {
  font-family: 'estamp Shippori Mincho B1';
  src: url('/fonts/shipporiminchob1/ShipporiMinchoB1-Regular.ttf') format('truetype');
  font-style: normal;
  font-weight: 400;
  font-display: block;
}
@font-face {
  font-family: 'estamp Shippori Mincho B1';
  src: url('/fonts/shipporiminchob1/ShipporiMinchoB1-Bold.ttf') format('truetype');
  font-style: normal;
  font-weight: 700;
  font-display: block;
}

html, body, button, input, select, textarea {
  font-family: 'estamp BIZ UDPGothic', sans-serif;
  font-size: 14px;
}
th, strong, summary { font-weight: 700; }

* { box-sizing: border-box; }
html, body, #app { height: 100%; margin: 0; }
body { background: var(--background); color: var(--text); overflow: hidden; }
p, button, summary { white-space: normal; overflow-wrap: anywhere; }
button, input, select, summary { min-height: 32px; }
button, input, select {
  font: inherit;
  color: inherit;
  background: var(--background);
  border: 1px solid var(--border);
  padding: 4px 8px;
  max-width: 100%;
}
input, select { border-radius: 4px; }
button { border-radius: 8px; cursor: pointer; }
button:hover:not(:disabled) { box-shadow: 0 1px 3px rgba(0,0,0,.12); }
button:disabled, fieldset:disabled { color: var(--muted); cursor: default; }
button:disabled { border-color: var(--border); }
:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
